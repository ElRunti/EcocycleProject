@* Create.cshtml *@
@model EcoCycleCore.Models.Cupone

@{
    ViewData["Title"] = "Nuevo cupón";
}

<div class="usuarios-header">
    <div class="container-fluid">
        <div class="eco-crud-eyebrow" style="color: var(--eco-sprout);">Recompensas</div>
        <h1>Nuevo cupón</h1>
        <p>Agrega una recompensa canjeable con puntos para los usuarios.</p>
    </div>
</div>

<div class="container-fluid mt-4">
    <div class="eco-form-card">
        <form asp-action="Create" asp-controller="Cupones">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="TiendaNombre" class="form-label">Tienda o marca</label>
                <input asp-for="TiendaNombre" class="form-control"
                       placeholder="Ej. Amazon, Starbucks, Netflix..." />
                <span asp-validation-for="TiendaNombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DescBeneficio" class="form-label">Descripción del beneficio</label>
                <textarea asp-for="DescBeneficio" class="form-control" rows="3"
                          placeholder="Ej. Tarjeta de regalo de $100 MXN en Amazon"></textarea>
                <span asp-validation-for="DescBeneficio" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CostPuntos" class="form-label">Costo en puntos</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background:var(--eco-sage);border-color:var(--eco-line);">
                            <i class="bi bi-star-fill text-warning"></i>
                        </span>
                        <input asp-for="CostPuntos" class="form-control" placeholder="Ej. 500" />
                    </div>
                    <span asp-validation-for="CostPuntos" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Stock" class="form-label">Stock disponible</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background:var(--eco-sage);border-color:var(--eco-line);">
                            <i class="bi bi-layers"></i>
                        </span>
                        <input asp-for="Stock" class="form-control" placeholder="Ej. 50" />
                    </div>
                    <span asp-validation-for="Stock" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn-eco-primary">
                    <i class="bi bi-check-circle me-1"></i> Crear cupón
                </button>
                <a asp-controller="Cupones" asp-action="Index" class="btn-eco-ghost-light">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@model EcoCycleCore.Models.Usuario

@{
    ViewData["Title"] = "Nuevo usuario";
}

<link rel="stylesheet" href="~/css/usuarios.css" />

<div class="usuarios-header">
    <div class="container-fluid">
        <div class="eco-crud-eyebrow" style="color: var(--eco-sprout);">Administración</div>
        <h1>Nuevo usuario</h1>
        <p>Registra una cuenta nueva en el sistema EcoCycle.</p>
    </div>
</div>

<div class="container-fluid">
    <div class="eco-form-card">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" placeholder="Nombre completo" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" type="email" placeholder="correo@ejemplo.com" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ContrasenaHash" class="form-label">Contraseña</label>
                <input asp-for="ContrasenaHash" class="form-control" type="password" placeholder="Contraseña" />
                <span asp-validation-for="ContrasenaHash" class="text-danger"></span>
                <div class="form-text"></div>
            </div>

            <div class="mb-3">
                <label asp-for="Telefono" class="form-label"></label>
                <input asp-for="Telefono" class="form-control" placeholder="Ej. 7771234567" />
                <span asp-validation-for="Telefono" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Direccion" class="form-label"></label>
                <textarea asp-for="Direccion" class="form-control" rows="2" placeholder="Dirección completa"></textarea>
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TipoUsuario" class="form-label"></label>
                <select asp-for="TipoUsuario" class="form-select">
                    <option value="">-- Selecciona un rol --</option>
                    <option value="Ciudadano">Ciudadano</option>
                    <option value="Admin">Admin</option>
                    <option value="Centro">Centro de recolección</option>
                </select>
                <span asp-validation-for="TipoUsuario" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn-eco-primary">
                    <i class="bi bi-person-check me-1"></i> Crear usuario
                </button>
                <a asp-action="Index" class="btn-eco-ghost-light">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
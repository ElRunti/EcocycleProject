@model EcoCycleCore.Models.Usuario

@{
    ViewData["Title"] = "Eliminar usuario";
}

<link rel="stylesheet" href="~/css/usuarios.css" />

<div class="usuarios-header">
    <div class="container-fluid">
        <div class="eco-crud-eyebrow" style="color: var(--eco-sprout);">Administración</div>
        <h1>Eliminar usuario</h1>
    </div>
</div>

<div class="container-fluid">
    <div class="alert alert-danger d-flex gap-2 align-items-start">
        <i class="bi bi-exclamation-triangle fs-4"></i>
        <div>
            <strong>¿Seguro que quieres eliminar este usuario?</strong>
            <p class="mb-0">Se eliminarán también todas sus publicaciones, entregas y canjes asociados (CASCADE).</p>
        </div>
    </div>

    <div class="eco-detail-card">
        <div class="td-nombre mb-3">
            <span class="usuario-avatar" style="width:48px;height:48px;font-size:1.1rem;">
                @Model.Nombre.Substring(0, 1).ToUpper()
            </span>
            <div>
                <strong>@Model.Nombre</strong><br />
                <small class="text-muted">@Model.Correo</small>
            </div>
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-4">Teléfono</dt>
            <dd class="col-sm-8">@(Model.Telefono ?? "—")</dd>

            <dt class="col-sm-4">Dirección</dt>
            <dd class="col-sm-8">@(Model.Direccion ?? "—")</dd>

            <dt class="col-sm-4">Tipo de usuario</dt>
            <dd class="col-sm-8">
                <span class="badge-tipo @(Model.TipoUsuario?.ToLower() == "admin" ? "badge-admin" :
                                                                Model.TipoUsuario?.ToLower() == "centro" ? "badge-centro" :
                                                                "badge-ciudadano")">
                    @Model.TipoUsuario
                </span>
            </dd>

            <dt class="col-sm-4">Puntos acumulados</dt>
            <dd class="col-sm-8">
                <span class="puntos-badge">
                    <i class="bi bi-star-fill"></i>
                    @(Model.PuntosAcumulacion ?? 0)
                </span>
            </dd>

            <dt class="col-sm-4">Contraseña</dt>
            <dd class="col-sm-8">
                <span class="contrasena-hidden">••••••••</span>
            </dd>

            <dt class="col-sm-4">Fecha de registro</dt>
            <dd class="col-sm-8">@Model.FechaRegistro?.ToString("dd/MM/yyyy")</dd>
        </dl>

        <form asp-action="Delete" class="d-flex gap-2 mt-3">
            <input type="hidden" asp-for="UsuarioId" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash3 me-1"></i> Sí, eliminar
            </button>
            <a asp-action="Index" class="btn-eco-ghost-light">Cancelar</a>
        </form>
    </div>
</div>
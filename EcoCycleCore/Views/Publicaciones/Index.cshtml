@model IEnumerable<EcoCycleCore.Models.Publicacione>

@{
    ViewData["Title"] = "Publicaciones";
    var rol = Context.Session.GetString("rol")?.ToLower();
    var usuarioId = Context.Session.GetInt32("usuarioId");
}

<div class="usuarios-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="eco-crud-eyebrow" style="color: var(--eco-sprout);">Publicaciones</div>
                <h1>Publicaciones de reciclaje</h1>
                <p>Material disponible para recolección y su estado actual.</p>
            </div>
            @if (rol == "usuario")
            {
                <a asp-controller="Publicaciones" asp-action="Create" class="btn-eco-primary">
                    <i class="bi bi-plus-circle me-1"></i> Nueva publicación
                </a>
            }
        </div>
    </div>
</div>

<div class="container-fluid mt-4">

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success d-flex gap-2 align-items-center mb-3">
            <i class="bi bi-check-circle"></i> @TempData["Ok"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger d-flex gap-2 align-items-center mb-3">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        </div>
    }

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Material</th>
                    <th>Usuario</th>
                    <th>Peso</th>
                    <th>Ubicación</th>
                    <th>Estado</th>
                    <th>Evidencia</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Material?.NombreMaterial</strong></td>
                        <td>@item.Usuario?.Nombre</td>
                        <td>@item.PesoCantidad kg</td>
                        <td class="text-muted" style="font-size:.85rem;">@item.Ubicacion</td>
                        <td>
                            @{
                                var badgeClass = item.Estado switch
                                {
                                    "Pendiente" => "bg-warning text-dark",
                                    "Solicitada" => "bg-info text-dark",
                                    "Aceptada" => "bg-primary text-white",
                                    "En Revision" => "bg-secondary text-white",
                                    "Finalizada" => "bg-success text-white",
                                    _ => "bg-light text-dark"
                                };
                            }
                            <span class="badge @badgeClass">@item.Estado</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.EvidenciaUrl))
                            {
                                <a href="@item.EvidenciaUrl" target="_blank">
                                    <img src="@item.EvidenciaUrl" alt="Evidencia"
                                         style="width:48px;height:48px;object-fit:cover;border-radius:8px;border:1px solid var(--eco-line);" />
                                </a>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size:.8rem;">Sin evidencia</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end flex-wrap">

                                @* RECOLECTOR: tomar publicación pendiente *@
                                @if (rol == "recolector" && item.Estado == "Pendiente" && item.RecolectorId == null)
                                {
                                    <form asp-action="SolicitarRecoleccion" asp-route-id="@item.PublicacionesId" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-hand-index me-1"></i> Tomar
                                        </button>
                                    </form>
                                }

                                @* RECOLECTOR: cancelar solicitud propia *@
                                @if (rol == "recolector" && item.Estado == "Solicitada" && item.RecolectorId == usuarioId)
                                {
                                    <form asp-action="CancelarSolicitud" asp-route-id="@item.PublicacionesId" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-circle me-1"></i> Cancelar
                                        </button>
                                    </form>
                                }

                                @* RECOLECTOR: subir evidencia cuando fue aceptado *@
                                @if (rol == "recolector" && item.Estado == "Aceptada" && item.RecolectorId == usuarioId)
                                {
                                    <a asp-action="SubirEvidencia" asp-route-id="@item.PublicacionesId" class="btn btn-sm btn-success">
                                        <i class="bi bi-camera me-1"></i> Subir evidencia
                                    </a>
                                }

                                @* USUARIO: aceptar o rechazar solicitud del recolector *@
                                @if (rol == "usuario" && item.Estado == "Solicitada" && item.UsuarioId == usuarioId)
                                {
                                    <form asp-action="AceptarSolicitud" asp-route-id="@item.PublicacionesId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-check-circle me-1"></i> Aceptar
                                        </button>
                                    </form>
                                    <form asp-action="RechazarSolicitud" asp-route-id="@item.PublicacionesId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-circle me-1"></i> Rechazar
                                        </button>
                                    </form>
                                }

                                @* ADMIN: aprobar o rechazar evidencia *@
                                @if (rol == "admin" && item.Estado == "En Revision")
                                {
                                    <form asp-action="AprobarEntregaAdmin" asp-route-id="@item.PublicacionesId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="number" name="puntosOtorgados" class="form-control form-control-sm d-inline"
                                               style="width:80px;" placeholder="Pts" min="1" required />
                                        <button type="submit" class="btn btn-sm btn-success ms-1">
                                            <i class="bi bi-check-circle me-1"></i> Aprobar
                                        </button>
                                    </form>
                                    <form asp-action="RechazarEvidencia" asp-route-id="@item.PublicacionesId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger ms-1">
                                            <i class="bi bi-x-circle me-1"></i> Rechazar
                                        </button>
                                    </form>
                                }

                                @* Detalles siempre visibles *@
                                <a asp-controller="Publicaciones" asp-action="Details"
                                   asp-route-id="@item.PublicacionesId" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i>
                                </a>

                                @* Admin puede eliminar *@
                                @if (rol == "admin")
                                {
                                    <a asp-controller="Publicaciones" asp-action="Delete"
                                       asp-route-id="@item.PublicacionesId" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="eco-empty-state text-center py-5">
            <i class="bi bi-megaphone"></i>
            <p class="mt-2 mb-0">No hay publicaciones disponibles.</p>
        </div>
    }
</div>
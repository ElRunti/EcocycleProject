@model IEnumerable<EcoCycleCore.Models.Publicacione>

@{
    ViewData["Title"] = "Publicaciones";

    var rol = Context.Session.GetString("rol");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold">Publicaciones</h2>
        <p class="text-muted mb-0">
            @if (rol == "Admin")
            {
                <span>Administración de publicaciones.</span>
            }
            else if (rol == "Recolector")
            {
                <span>Material disponible para recolección.</span>
            }
            else
            {
                <span>Mis publicaciones.</span>
            }
        </p>
    </div>

    @if (rol == "Usuario")
    {
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i>
            Nueva publicación
        </a>
    }
</div>

<div class="row">
    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success">
            @TempData["Ok"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @foreach (var item in Model)
    {
        <div class="col-lg-4 col-md-6 mb-4">

            <div class="card shadow-sm h-100">

                @if (!string.IsNullOrEmpty(item.UrlImagen))
                {
                    <img src="@item.UrlImagen"
                         class="card-img-top"
                         style="height:220px; object-fit:cover;" />
                }

                <div class="card-body">

                    <h5 class="card-title">
                        @item.Material.NombreMaterial
                    </h5>

                    <p class="card-text">
                        @item.Descripcion
                    </p>

                    <hr />

                    <p class="mb-1">
                        <strong>Peso:</strong>
                        @item.PesoCantidad kg
                    </p>

                    <p class="mb-1">
                        <strong>Ubicación:</strong>
                        @item.Ubicacion
                    </p>

                    <p class="mb-1">
                        <strong>Publicado por:</strong>
                        @item.Usuario.Nombre
                    </p>

                    <p class="mb-3">
                        <strong>Estado:</strong>

                        @switch (item.Estado)
                        {
                            case "Pendiente":
                                <span class="badge bg-warning text-dark">
                                    Pendiente
                                </span>
                                break;

                            case "Solicitada":
                                <span class="badge bg-info">
                                    Solicitada
                                </span>
                                break;

                            case "Aceptada":
                                <span class="badge bg-primary">
                                    Aceptada
                                </span>
                                break;

                            case "Entregada":
                                <span class="badge bg-secondary">
                                    Entregada
                                </span>
                                break;

                            case "Finalizada":
                                <span class="badge bg-success">
                                    Finalizada
                                </span>
                                break;

                            default:
                                <span class="badge bg-dark">
                                    @item.Estado
                                </span>
                                break;
                        }

                    </p>

                </div>

                <div class="card-footer bg-white">

                    @if (rol == "Admin")
                    {
                        <a asp-action="Details"
                           asp-route-id="@item.PublicacionesId"
                           class="btn btn-outline-primary btn-sm">
                            Ver
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.PublicacionesId"
                           class="btn btn-outline-warning btn-sm">
                            Editar
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.PublicacionesId"
                           class="btn btn-outline-danger btn-sm">
                            Eliminar
                        </a>
                    }

                    else if (rol == "Usuario")
                    {
                        <a asp-action="Details"
                           asp-route-id="@item.PublicacionesId"
                           class="btn btn-primary btn-sm">
                            Ver detalles
                        </a>
                    }

                    else if (rol == "Recolector")
                    {
                        <form asp-action="SolicitarRecoleccion"
                              asp-route-id="@item.PublicacionesId"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit" class="btn btn-success btn-sm">
                                Quiero recoger
                            </button>

                        </form>
                    }

                </div>

            </div>

        </div>
    }

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay publicaciones disponibles.
    </div>
}
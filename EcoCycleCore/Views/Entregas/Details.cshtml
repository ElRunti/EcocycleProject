@model EcoCycleCore.Models.Entrega
@{
    ViewData["Title"] = "Detalle de Entrega";
}

<h1>Detalle de Entrega</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Ciudadano</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Ciudadano.Nombre)</dd>

        <dt class="col-sm-3">Publicación</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Publicacion.Descripcion)</dd>

        <dt class="col-sm-3">Recolector</dt>
        <dd class="col-sm-9">@(Model.Publicacion?.Recolector?.Nombre ?? "Sin asignar")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PesoReal)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.PesoReal) kg</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PuntosOtorgados)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.PuntosOtorgados) pts</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaEntrega)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.FechaEntrega)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.EntregaId" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
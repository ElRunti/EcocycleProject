@model EcoCycleCore.Models.Materiale

@{
    ViewData["Title"] = "Nuevo material";
}

<div class="usuarios-header">
    <div class="container-fluid">
        <div class="eco-crud-eyebrow" style="color: var(--eco-sprout);">Administración</div>
        <h1>Registrar material</h1>
        <p>Agrega un tipo de material reciclable y define cuántos puntos otorga por kilo entregado.</p>
    </div>
</div>

<div class="container-fluid mt-4">
    <div class="eco-form-card">
        <form asp-action="Create" asp-controller="Materiales">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="NombreMaterial" class="form-label"></label>
                <input asp-for="NombreMaterial" class="form-control" placeholder="Ej. Plástico PET, Cartón, Aluminio..." />
                <span asp-validation-for="NombreMaterial" class="text-danger"></span>
                <div class="form-text">Nombre claro que el ciudadano pueda identificar fácilmente.</div>
            </div>

            <div class="mb-3">
                <label asp-for="PuntosPorKilo" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="PuntosPorKilo" class="form-control" placeholder="Ej. 10" />
                    <span class="input-group-text" style="background:var(--eco-sage);border-color:var(--eco-line);color:var(--eco-forest);font-weight:600;">
                        pts / kg
                    </span>
                </div>
                <span asp-validation-for="PuntosPorKilo" class="text-danger"></span>
                <div class="form-text">Puntos que recibe el ciudadano por cada kilogramo de este material.</div>
            </div>

            <div class="eco-puntos-preview p-3 rounded-3 mb-4" style="background:var(--eco-sage);">
                <small class="text-muted d-block mb-1">Ejemplo de ganancia</small>
                <span style="color:var(--eco-forest);font-weight:600;">
                    <i class="bi bi-calculator me-1"></i>
                    5 kg × <span id="preview-pts">0</span> pts = <span id="preview-total">0</span> pts totales
                </span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-eco-primary">
                    <i class="bi bi-check-circle me-1"></i> Guardar material
                </button>
                <a asp-controller="Materiales" asp-action="Index" class="btn-eco-ghost-light">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const input = document.getElementById('PuntosPorKilo');
        const previewPts = document.getElementById('preview-pts');
        const previewTotal = document.getElementById('preview-total');
        input?.addEventListener('input', () => {
            const val = parseFloat(input.value) || 0;
            previewPts.textContent = val;
            previewTotal.textContent = (val * 5).toFixed(0);
        });
    </script>
}
@model EcoCycleCore.Models.Materiale

@{
    ViewData["Title"] = "Eliminar material";
}

<div class="usuarios-header">
    <div class="container-fluid">
        <div class="eco-crud-eyebrow" style="color: var(--eco-sprout);">Administración</div>
        <h1>Eliminar material</h1>
    </div>
</div>

<div class="container-fluid mt-4">
    <div class="alert alert-danger d-flex gap-2 align-items-start">
        <i class="bi bi-exclamation-triangle fs-4"></i>
        <div>
            <strong>¿Seguro que quieres eliminar este material?</strong>
            <p class="mb-0">Todas las publicaciones y entregas asociadas a este material también se verán afectadas (CASCADE).</p>
        </div>
    </div>

    <div class="eco-detail-card">
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="material-icon-lg"><i class="bi bi-recycle"></i></span>
            <div>
                <h3 class="mb-0">@Model.NombreMaterial</h3>
                <small class="text-muted">ID #@Model.MaterialId</small>
            </div>
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-4">Nombre del material</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.NombreMaterial)</dd>

            <dt class="col-sm-4">Puntos por kilo</dt>
            <dd class="col-sm-8">
                <span class="puntos-badge">
                    <i class="bi bi-star-fill"></i>
                    @Html.DisplayFor(model => model.PuntosPorKilo) pts/kg
                </span>
            </dd>
        </dl>

        <form asp-action="Delete" asp-controller="Materiales" class="d-flex gap-2 mt-4">
            <input type="hidden" asp-for="MaterialId" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash3 me-1"></i> Sí, eliminar
            </button>
            <a asp-controller="Materiales" asp-action="Index" class="btn-eco-ghost-light">Cancelar</a>
        </form>
    </div>
</div>
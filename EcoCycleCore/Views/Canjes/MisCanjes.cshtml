@model IEnumerable<EcoCycleCore.Models.Canje>

@{
    ViewData["Title"] = "Mis canjes";
    var misPuntos = (int)(ViewBag.MisPuntos ?? 0);
}

<div class="usuarios-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <div class="eco-crud-eyebrow" style="color: var(--eco-sprout);">Mi cuenta</div>
                <h1>Mis canjes</h1>
                <p>Aquí están todos los cupones que has canjeado.</p>
            </div>
            <div>
                <span class="puntos-badge fs-6 px-3 py-2">
                    <i class="bi bi-star-fill"></i>
                    <strong>@misPuntos pts</strong> restantes
                </span>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid mt-4">

    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success d-flex gap-2 mb-4">
            <i class="bi bi-check-circle fs-5"></i> @TempData["Ok"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="eco-empty-state text-center py-5">
            <i class="bi bi-ticket-perforated"></i>
            <p class="mt-2 mb-0">Todavía no has canjeado ninguna recompensa.</p>
            <a asp-controller="Cupones" asp-action="Index" class="btn-eco-primary mt-3">
                <i class="bi bi-gift me-1"></i> Ver recompensas disponibles
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="canje-card">
                        <div class="canje-card-header">
                            <span class="cupon-store">@item.Cupon?.TiendaNombre</span>
                            <span class="badge bg-success">Canjeado</span>
                        </div>
                        <h5 class="cupon-title mt-2">@item.Cupon?.DescBeneficio</h5>

                        <div class="canje-codigo">
                            <small class="text-muted d-block mb-1">TU CÓDIGO</small>
                            <code class="fs-6 fw-bold">@item.CodigoDigital</code>
                            <button class="btn btn-sm btn-outline-secondary ms-2"
                                    onclick="navigator.clipboard.writeText('@item.CodigoDigital');this.innerHTML='<i class=\'bi bi-check\'></i>'">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="puntos-badge">
                                <i class="bi bi-star-fill"></i> @item.Cupon?.CostPuntos pts
                            </span>
                            <small class="text-muted">
                                @item.FechaCanje?.ToString("dd/MM/yyyy")
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>